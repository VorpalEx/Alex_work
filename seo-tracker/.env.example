# ============================================================================
#  SEO Tracker — variables d'environnement
#  Copie ce fichier en `.env` et remplis les valeurs. Ne commit JAMAIS le .env.
# ============================================================================

# --- Google (Search Console + GA4) ------------------------------------------
# Deux façons de fournir la clé du compte de service :
#   1) chemin vers le fichier JSON téléchargé depuis Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#   2) OU le contenu JSON brut (pratique pour GitHub Actions -> secret).
#      Si GOOGLE_CREDENTIALS_JSON est défini, il a la priorité.
# GOOGLE_CREDENTIALS_JSON=

# Propriété Search Console.
#   - Propriété "Domaine"        -> sc-domain:dillygence.com
#   - Propriété "Préfixe d'URL"  -> https://dillygence.com/
GSC_SITE_URL=sc-domain:dillygence.com

# ID numérique de la propriété GA4 (Admin > Paramètres de la propriété).
# Format : 123456789 (SANS le préfixe "properties/").
GA4_PROPERTY_ID=

# --- Notion -----------------------------------------------------------------
# Token de l'intégration interne (https://www.notion.so/my-integrations).
# Pense à PARTAGER les 2 bases avec l'intégration (menu ... > Connexions).
NOTION_TOKEN=

# IDs des bases (déjà pré-remplis, ne pas changer sauf recréation des bases).
NOTION_DB_ARTICLES=c0b3d33b-b346-4831-ae15-75a96cd8f585
NOTION_DB_KEYWORDS=5ff559ca-b4b6-4fe5-b6af-9235a3f31e9c

# --- Framer (source d'inventaire des articles, optionnel) --------------------
# Permet de lister TOUS les articles publiés (même ceux sans trafic) et d'avoir
# leur vrai titre. La récupération se fait via le SDK Node officiel `framer-api`
# (dossier framer/), qui écrit un JSON lu ensuite par Python.
#
# 1) Token API : réglages du projet Framer (plan payant requis).
FRAMER_API_TOKEN=
# 2) URL du projet Framer (visible dans l'URL de l'éditeur).
FRAMER_PROJECT_URL=https://framer.com/projects/XXXXXXXX
# 3) Collections à inclure : "NomExact=prefixe" séparées par des virgules.
#    Découvre les noms exacts via la sonde :  cd framer && npm i && node probe.mjs
FRAMER_COLLECTIONS=News=/news,Blog=/blog,Use Cases=/use-case
# Base du site public (pour reconstruire les URLs).
SITE_BASE_URL=https://dillygence.com
# Par défaut on utilise le slug de BASE (anglais) = les URLs live de dillygence.com,
# et on garde le slug localisé (FR) en alias pour la jointure. Mettre "true"
# seulement si les URLs live utilisent le slug localisé.
FRAMER_USE_LOCALIZED_SLUG=false
# Fichier JSON d'inventaire produit par le script Node (lu par Python).
FRAMER_INVENTORY_FILE=framer_inventory.json

# --- Paramètres du rapport ---------------------------------------------------
# Fenêtre d'analyse en jours (glissante).
LOOKBACK_DAYS=28

# Filtre des URLs à considérer comme "articles" (regex Python, insensible à la casse).
#   - vide (ou non défini) -> filtre par défaut ci-dessous (EN + vraies sections FR)
#   - "all" -> tout inclure (aucun filtre)
#   - sinon -> ta propre regex
# FR : les vraies pages sont /fr/actualites/ (news) et /fr/cas-d-usage/ (use cases).
ARTICLE_URL_REGEX=/(news|blog|use-cases?|cases|fr/actualites|fr/cas-d-usage)(/|$)

# URLs à bannir (l'exclusion l'emporte sur l'inclusion). Par défaut on écarte les
# variantes FR non-canoniques /fr/news, /fr/use-case(s), /fr/blog, /fr/cases.
#   - vide (ou non défini) -> exclusion par défaut ci-dessous
#   - "none" -> aucune exclusion
ARTICLE_URL_EXCLUDE=/fr/(news|blog|use-cases?|cases)(/|$)

# Nombre max de mots-clés remontés par article (les plus performants d'abord).
# 0 = illimité.
MAX_KEYWORDS_PER_ARTICLE=0

# Nombre min d'impressions pour qu'un mot-clé soit enregistré (réduit le bruit).
MIN_IMPRESSIONS=1

# Archiver dans Notion les lignes qui ne sont plus remontées (true/false).
PRUNE_STALE=false
